rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // users/{uid}
    // A user may read/create/update their own profile. Only the
    // "role" and "isBanned" fields are admin-only to change — enforced
    // by comparing incoming vs existing values.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.isBanned == resource.data.isBanned
        || isAdmin();
      allow delete: if isAdmin();
    }

    // shops/{shopId} — Phase 2+. Any verified user may create a shop
    // they own; only the owner or an admin may update/delete it, and
    // it only becomes publicly visible once an admin approves it.
    match /shops/{shopId} {
      allow read: if resource.data.status == 'approved' || isAdmin() ||
        (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isVerified() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // products/{productId} — Phase 2+. Only the owning shop's seller
    // (or an admin) may write; anyone may read non-hidden products.
    match /products/{productId} {
      allow read: if resource.data.status != 'hidden' || isAdmin() ||
        (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if isVerified() &&
        request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isSignedIn() && resource.data.sellerId == request.auth.uid);
    }

    // orders/{orderId} — Phase 2+. Only the buyer, the seller of the
    // order, or an admin may read/write it.
    match /orders/{orderId} {
      allow read, update: if isAdmin() ||
        (isSignedIn() && (resource.data.buyerId == request.auth.uid ||
          resource.data.sellerId == request.auth.uid));
      allow create: if isVerified() &&
        request.resource.data.buyerId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // categories/{categoryId} — admin-managed, public read.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // reviews/{reviewId} — any verified buyer may leave one review per
    // product; only the author or an admin may edit/delete it.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isVerified() &&
        request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    // notifications/{notificationId} — a user only ever sees their own.
    match /notifications/{notificationId} {
      allow read, update: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAdmin() || isSignedIn();
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // reports/{reportId} — any signed-in user may file one; only
    // admins may read/resolve them.
    match /reports/{reportId} {
      allow create: if isVerified();
      allow read, update, delete: if isAdmin();
    }
  }
}
